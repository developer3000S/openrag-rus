# syntax=docker/dockerfile:1.4

# -----------------------------------------------------------------------------
# Stage: deps
# -----------------------------------------------------------------------------
# Debian (bookworm) glibc is compiled against the x86-64-baseline ISA level
# with full fallback dispatch, unlike the Red Hat/UBI glibc that hard-fails
# with "Fatal glibc error: CPU does not support x86-64-v3" on pre-AVX2 (v2)
# CPUs such as Sandy Bridge. Using a Debian base lets the image run on v2 hosts.
FROM node:24-bookworm AS deps

WORKDIR /opt/app-root/src

# node:24-bookworm ships CA certs, curl, and wget out of the box, so no apt setup
# is needed for npm to reach the registry.

COPY frontend/package.json frontend/package-lock.json ./
# Copy local stub packages referenced via file: in package.json (e.g. sharp stub
# that keeps LGPL libvips binaries out of the tree). npm ci needs these present.
COPY frontend/stubs ./stubs

RUN npm ci --prefer-offline --no-audit

# -----------------------------------------------------------------------------
# Stage: builder
# -----------------------------------------------------------------------------
FROM node:24-bookworm AS builder

WORKDIR /opt/app-root/src

COPY --from=deps /opt/app-root/src/node_modules ./node_modules
COPY --from=deps /opt/app-root/src/stubs ./stubs
COPY frontend/package*.json ./
COPY frontend/ ./

RUN npm run build \
    && npm prune --omit=dev

# -----------------------------------------------------------------------------
# Stage: runtime
# -----------------------------------------------------------------------------
FROM node:24-bookworm AS runtime

WORKDIR /opt/app-root/src

# Create a non-root runtime user (uid 1001, as before).
RUN groupadd --gid 1001 appuser \
    && useradd --uid 1001 --gid 1001 --no-create-home appuser

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

# CWE-426 fix: explicitly set PATH so system-owned directories are always resolved
# first. App venv dirs are appended last so they cannot shadow system binaries.
# Matches the ordering used by the upstream image but with system dirs promoted
# to the front.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/app-root/bin:/opt/app-root/src/bin:/opt/app-root/src/.local/bin

COPY --from=builder --chown=1001:0 /opt/app-root/src/package*.json ./
COPY --from=builder --chown=1001:0 /opt/app-root/src/stubs ./stubs
COPY --from=builder --chown=1001:0 /opt/app-root/src/.next ./.next
COPY --from=builder --chown=1001:0 /opt/app-root/src/public ./public
COPY --from=builder --chown=1001:0 /opt/app-root/src/node_modules ./node_modules
COPY --from=builder --chown=1001:0 /opt/app-root/src/next.config.* ./
COPY --from=builder --chown=1001:0 /opt/app-root/src/postcss.config.* ./
COPY --from=builder --chown=1001:0 /opt/app-root/src/tailwind.config.* ./
COPY --from=builder --chown=1001:0 /opt/app-root/src/biome.json* ./

EXPOSE 3000 9090
USER 1001

CMD ["npm", "start"]
