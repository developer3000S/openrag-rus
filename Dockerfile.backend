# syntax=docker/dockerfile:1.4
# BuildKit: enables cache mounts and better layer reuse.
#
# Build: docker build -t openrag-backend -f Dockerfile.backend .

# -----------------------------------------------------------------------------
# Stage: base (system + uv)
# -----------------------------------------------------------------------------
# Debian (bookworm) glibc is compiled against the x86-64-baseline ISA level
# with full fallback dispatch, unlike the Red Hat/UBI glibc that hard-fails
# with "Fatal glibc error: CPU does not support x86-64-v3" on pre-AVX2 (v2)
# CPUs such as Sandy Bridge. Using a Debian base lets the image run on v2 hosts.
FROM python:3.14-slim-bookworm AS base

# Install system dependencies using apt (Debian package manager)
USER root

# Configure apt: use a reachable Debian mirror over HTTPS and force IPv4.
# The default deb.debian.org (Fastly) endpoint is unreachable from restricted
# build networks, so we point at mirrors.cloud.tencent.com instead.
RUN printf 'Types: deb\nURIs: https://mirrors.cloud.tencent.com/debian\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: https://mirrors.cloud.tencent.com/debian-security\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' > /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::ForceIPv4 "true";\n' > /etc/apt/apt.conf.d/99force-ipv4

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    openssl \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && python -m pip install --no-cache-dir --upgrade "pip>=26.1.2" "setuptools>=78.1.1"

ENV PATH="$PATH:/root/.local/bin" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# -----------------------------------------------------------------------------
# Stage: builder (deps + app)
# -----------------------------------------------------------------------------
FROM base AS builder

# Build-time deps only (not in final image); apt sources inherited from base stage
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    git \
    gcc \
    g++ \
    make \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependency layer: reuse as long as lockfile and pyproject don't change
# --extra apm bakes in the Instana tracer so the published image can turn APM on
# with INSTANA_ENABLED alone. The extra exists so source installs that will never
# enable it don't pay for the tracer; images ship with the capability present.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,uid=0,gid=0 \
    uv sync --extra apm

# Application (invalidates after deps only when src/flows change)
COPY src/ ./src/
COPY enhancements/ ./enhancements/
COPY flows/ ./flows/
COPY securityconfig/ ./securityconfig/
COPY cloud_securityconfig/ ./cloud_securityconfig/
# Alembic migrations — the runtime calls run_alembic_upgrade("head") on
# startup. Without these the migration silently no-ops with
# "alembic.ini not found; skipping schema upgrade", and the SQL DB
# starts empty (no users / conversations / session_ownership tables).
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY openrag-documents/ ./openrag-documents/

# -----------------------------------------------------------------------------
# Stage: runtime (minimal image)
# -----------------------------------------------------------------------------
FROM python:3.14-slim-bookworm AS runtime

# Install runtime dependencies
USER root

# Use the same reachable Debian mirror as the base stage (see base).
RUN printf 'Types: deb\nURIs: https://mirrors.cloud.tencent.com/debian\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: https://mirrors.cloud.tencent.com/debian-security\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' > /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::ForceIPv4 "true";\n' > /etc/apt/apt.conf.d/99force-ipv4 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    openssl \
    util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --upgrade "pip>=26.1.2" "setuptools>=78.1.1"

# Create a non-root user/group.
# UID/GID 1000 is the conventional first non-root account and
# matches what Podman's :U volume flag maps to.
RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --no-create-home appuser

WORKDIR /app

# Copy files directly with non-root ownership to avoid layer duplication via chown -R
COPY --from=builder --chown=appuser:appuser /app /app
COPY --chown=appuser:appuser securityconfig/ ./securityconfig/
COPY --chown=appuser:appuser cloud_securityconfig/ ./cloud_securityconfig/
COPY --chown=appuser:appuser scripts/backend-entrypoint.sh /entrypoint.sh

ENV VIRTUAL_ENV=/app/.venv
# CWE-426 fix: explicitly set PATH so system-owned directories are always resolved
# first. App venv dirs are appended last so they cannot shadow system binaries.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/app/.venv/bin:/opt/app-root/bin:/opt/app-root/src/bin:/opt/app-root/src/.local/bin

# Pre-create every directory the app writes to at runtime so they are owned
# by appuser in the image layer. When Docker/Podman mounts a host volume over
# one of these paths the mount takes precedence, but the ownership baked here
# acts as a safe default when no volume is attached (e.g. CI, unit tests).
#
# Writable paths:
#   keys/              - RSA JWT keys (private_key.pem / public_key.pem)
#   data/              - connections.json
#   config/            - config.yaml (ConfigManager runtime settings)
#   flows/backup/      - Langflow flow backups (flows/ itself is COPY'd from builder)
#   openrag-documents/ - uploaded documents staging area
RUN mkdir -p keys data config flows/backup openrag-documents \
    && chown -R appuser:appuser keys data config flows/backup openrag-documents \
    && chmod +x /entrypoint.sh

EXPOSE 8000
# Ingestion-callback proxy router (OPENRAG_BACKEND_ROUTER_ENABLE), when enabled.
EXPOSE 8100

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/app/.venv/bin/python", "src/main.py"]